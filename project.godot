; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TemplateProject"
run/main_scene="uid://dvobonlj2bvbe"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://Autoloads/AudioAdmin/default_bus_layout.tres"

[autoload]

AudioAdmin="*uid://bnj6ffacgsp30"
Transitions="*uid://bm4eti4c7pyko"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/auto_node_reference/plugin.cfg", "res://addons/auto_script_edits/plugin.cfg", "res://addons/autosize_label/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

